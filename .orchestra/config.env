# Orchestra config for bakuran-gitops (Forgejo origin, PR-only, GitOps render/state/gate hooks).
ORCHESTRA_BASE=forgejo/main
ORCHESTRA_LAND=pr
ORCHESTRA_PR_CMD="$HOME/projects/orchestra/examples/forgejo-pr.sh"
ORCHESTRA_STATE_CMD='kubectl -n argocd get applications -o jsonpath="{range .items[*]}{.metadata.name}\t{.status.sync.status}\t{.status.health.status}\n{end}" 2>/dev/null | sort; echo "---"; kubectl get ns --no-headers 2>/dev/null | awk "{print \$1}" | sort'
ORCHESTRA_RENDER_CMD='for d in $(git diff --name-only "$ORCHESTRA_BASE" 2>/dev/null | awk -F/ "/^manifests\/base\//{print \$1\"/\"\$2\"/\"\$3}" | sort -u); do [ -f "$d/kustomization.yaml" ] && echo "=== $d ===" && kubectl kustomize "$d"; done'
ORCHESTRA_GATE='sh -c "set -e; for d in \$(git diff --name-only forgejo/main 2>/dev/null | awk -F/ \"/^manifests\\/base\\//{print \\\$1\\\"/\\\"\\\$2\\\"/\\\"\\\$3}\" | sort -u); do [ -f \"\$d/kustomization.yaml\" ] || continue; out=\$(kubectl kustomize \"\$d\"); if printf \"%s\n\" \"\$out\" | grep -E \"^[[:space:]]+(- )?(image|imageName):\" | grep -v \"@sha256:\"; then exit 1; fi; done"'
