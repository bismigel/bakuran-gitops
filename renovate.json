{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Toronto",
  "schedule": [
    "before 6am on monday"
  ],
  "automerge": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "dependencyDashboard": true,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "nix": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^manifests/.+\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^clusters/.+\\.ya?ml$/"
    ]
  },
  "pinDigests": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "non-major updates"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
